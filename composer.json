{
    "name": "cywolf/page_link_insights",
    "version": "3.0.1",
    "type": "typo3-cms-extension",
    "description": "Maps internal linking from the TYPO3 reference index and draws it as an interactive force diagram, with per-language theme extraction and broken link detection.",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": "^8.2",
        "typo3/cms-core": "^14.0",
        "typo3/cms-backend": "^14.0",
        "typo3/cms-extbase": "^14.0",
        "typo3/cms-fluid": "^14.0",
        "typo3/cms-scheduler": "^14.0",
        "cywolf/nlp-tools": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Cywolf\\PageLinkInsights\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "page_link_insights"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
